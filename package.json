{
  "name": "oxc-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run generate && vite",
    "generate": "node scripts/generate.mjs",
    "build": "npm run generate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxc-minify": "0.156.0",
    "oxc-parser": "0.156.0",
    "oxc-resolver": "11.24.3",
    "oxc-transform": "0.156.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.8"
  }
}
